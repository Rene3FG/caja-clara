# Copiar a .env y llenar. NUNCA subir .env al repositorio.

# --- Backend ---
DB_PATH=
BACKEND_PORT=

# --- Detector de visión ---
# Ruta a los pesos entrenados por el equipo (.pt de YOLO o .engine de TensorRT)
VISION_WEIGHTS=
# sha256 esperado de VISION_WEIGHTS (ver modelos/README.md)
VISION_SHA256=
VISION_CONF=

# --- Asistente (LLM servido en DGX Spark, API compatible con OpenAI) ---
LLM_BASE_URL=
LLM_MODEL=
LLM_API_KEY=
# sha256 esperado del adaptador LoRA (informativo; ver modelos/README.md)
LORA_SHA256=

# --- RAG (embeddings NIM) ---
NIM_EMBED_URL=
NIM_EMBED_MODEL=
NIM_API_KEY=
